{
  "name": "@0xbb2b/one-company",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "description": "pi 的需求驱动开发流程包：主会话和用户确认需求，守护进程内的需求代理（PM）规划任务，派角色子代理完成实施、审查与验收",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "tdd",
    "workflow",
    "subagents"
  ],
  "files": [
    "agents",
    "resources/tree-sitter",
    "role-rules",
    "rules",
    "shared",
    "skills",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node src/core/exec/git-prerequisite.mjs --check",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/installation/**' --exclude 'tests/acceptance/**'",
    "test:integration": "vitest run tests/integration",
    "test:integration:installed": "ONE_COMPANY_TEST_INSTALLED=1 vitest run tests/integration",
    "test:installation": "vitest run tests/installation",
    "test:acceptance": "vitest run tests/acceptance",
    "test:acceptance:parallel": "node tests/acceptance/run-parallel.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/app/extension/index.ts"
    ],
    "prompts": []
  },
  "dependencies": {
    "jiti": "2.7.0",
    "web-tree-sitter": "0.27.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.4.1",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
