{
  "name": "@0xbb2b/pi-company",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "description": "pi 的需求驱动开发流程包：主会话对齐需求，守护进程内的需求代理按工作流形状调度角色子代理完成实施、审查与验收",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "spec",
    "tdd",
    "workflow",
    "subagents"
  ],
  "files": [
    "agents",
    "daemon",
    "extensions",
    "resources/tree-sitter",
    "resources/spec",
    "runtime",
    "rules",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node runtime/git-prerequisite.mjs --check",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/installation/**'",
    "test:integration": "vitest run tests/integration",
    "test:installation": "vitest run tests/installation",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "prompts": []
  },
  "dependencies": {
    "jiti": "2.7.0",
    "typebox": "1.3.29",
    "web-tree-sitter": "0.27.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "26.4.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
